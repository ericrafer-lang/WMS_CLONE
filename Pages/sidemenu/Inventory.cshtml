@page "/Inventory"
@model WMSys.Pages.sidemenu.InventoryModel
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Inventory</h2>
        <p class="text-muted mb-0">Manage warehouse stock and monitor inventory levels.</p>
    </div>

    <button class="btn btn-primary">
        <i class="fas fa-plus"></i> Add Item
    </button>
</div>

<!-- Summary Cards -->

<div class="row g-4 mb-4">

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Total Products</h6>
                <h2 class="fw-bold">1,245</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">In Stock</h6>
                <h2 class="fw-bold text-success">1,180</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Low Stock</h6>
                <h2 class="fw-bold text-warning">43</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="text-muted">Out of Stock</h6>
                <h2 class="fw-bold text-danger">22</h2>
            </div>
        </div>
    </div>

</div>

<!-- Search & Filter -->

<div class="card shadow-sm border-0 rounded-4 mb-4">

    <div class="card-body">

        <div class="row g-3">

            <div class="col-lg-6">
                <input type="text"
                       class="form-control"
                       placeholder="Search product...">
            </div>

            <div class="col-lg-3">
                <select class="form-select">
                    <option>All Categories</option>
                    <option>Electronics</option>
                    <option>Food</option>
                    <option>Office Supplies</option>
                </select>
            </div>

            <div class="col-lg-3 text-end">

                <button class="btn btn-outline-secondary">
                    <i class="fas fa-file-export"></i>
                    Export
                </button>

                <button class="btn btn-primary">
                    <i class="fas fa-filter"></i>
                    Filter
                </button>

            </div>

        </div>

    </div>

</div>

<!-- Inventory Table -->

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-header bg-white">
        <h5 class="mb-0 fw-semibold">
            Inventory List
        </h5>
    </div>

    <div class="table-responsive">

        <table class="table align-middle mb-0">

            <thead class="table-light">

                <tr>

                    <th>SKU</th>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Location</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th>Stock Level</th>
                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>INV-1001</td>

                    <td>
                        Wireless Mouse
                    </td>

                    <td>Electronics</td>

                    <td>A-01</td>

                    <td>245</td>

                    <td>
                        <span class="badge bg-success">
                            In Stock
                        </span>
                    </td>

                    <td width="220">

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width:85%">
                            </div>

                        </div>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">
                            Edit
                        </button>

                    </td>

                </tr>

                <tr>

                    <td>INV-1002</td>

                    <td>Keyboard</td>

                    <td>Electronics</td>

                    <td>A-03</td>

                    <td>21</td>

                    <td>

                        <span class="badge bg-warning text-dark">

                            Low Stock

                        </span>

                    </td>

                    <td>

                        <div class="progress">

                            <div class="progress-bar bg-warning"
                                 style="width:25%">
                            </div>

                        </div>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">
                            Edit
                        </button>

                    </td>

                </tr>

                <tr>

                    <td>INV-1003</td>

                    <td>Monitor</td>

                    <td>Electronics</td>

                    <td>B-05</td>

                    <td>0</td>

                    <td>

                        <span class="badge bg-danger">
                            Out of Stock
                        </span>

                    </td>

                    <td>

                        <div class="progress">

                            <div class="progress-bar bg-danger"
                                 style="width:0%">
                            </div>

                        </div>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">
                            Edit
                        </button>

                    </td>

                </tr>

                <tr>

                    <td>INV-1004</td>

                    <td>USB Cable</td>

                    <td>Accessories</td>

                    <td>C-12</td>

                    <td>520</td>

                    <td>

                        <span class="badge bg-success">
                            In Stock
                        </span>

                    </td>

                    <td>

                        <div class="progress">

                            <div class="progress-bar bg-success"
                                 style="width:95%">
                            </div>

                        </div>

                    </td>

                    <td>

                        <button class="btn btn-sm btn-outline-primary">
                            Edit
                        </button>

                    </td>

                </tr>

            </tbody>

        </table>

    </div>

</div>