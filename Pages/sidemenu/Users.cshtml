@page "/Users"
@model WMSys.Pages.sidemenu.UsersModel
@{
    ViewData["Title"] = "User Management";
}

<h1>User Management</h1>
<p>Manage user roles and access levels.</p>

<!-- Invite User Button -->
<div class="mb-3 text-end">
    <button class="btn btn-primary">+ Invite User</button>
</div>

<!-- Role Cards -->
<div class="role-cards">
    <div class="role-card">
        <h4>Administrator</h4>
        <p>Full access to all modules, user management, delete permissions.</p>
    </div>
    <div class="role-card">
        <h4>Warehouse Supervisor</h4>
        <p>Access to all operational modules. Cannot delete inventory or manage users.</p>
    </div>
    <div class="role-card">
        <h4>Warehouse Staff</h4>
        <p>Access to Dashboard, Receiving check-ins, and Shipping status updates only.</p>
    </div>
</div>

<hr />

<!-- User Table -->
<h3>All Users</h3>
<table class="users-table table table-striped">
    <thead class="table-dark">
        <tr>
            <th>User</th>
            <th>Email</th>
            <th>Current Role</th>
            <th>Change Role</th>
        </tr>
    </thead>
