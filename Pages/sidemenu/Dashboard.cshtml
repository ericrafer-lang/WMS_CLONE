@page "/Dashboard"
@model WMSys.Pages.sidemenu.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Warehouse Overview</h1>

<div class="metrics">
    <div class="metric-box up">
        <h3>Total Inventory Value</h3>
        <p>$159,423 <span>(+12.5%)</span></p>
    </div>
    <div class="metric-box up">
        <h3>Active Orders</h3>
        <p>6 <span>(+8.2%)</span></p>
    </div>
    <div class="metric-box down">
        <h3>Pending Shipments</h3>
        <p>4 <span>(-3.1%)</span></p>
    </div>
    <div class="metric-box alert">
        <h3>Low Stock Alerts</h3>
        <p>5 items</p>
    </div>
</div>

<div class="chart-section">
    <h3>Inventory Movement</h3>
    <canvas id="inventoryChart"></canvas>
</div>

<div class="recent-activity">
    <h3>Recent Activity</h3>
    <ul>
        <li>PO-4895 received — 45 units from KLTFruits (7/7/2026)</li>
        <li>PO-4892 received — 240 units from TechoPark (7/6/2026)</li>
        <li>PO-4890 received — 80 units from FCIE (7/6/2026)</li>
        <li>Shipment SHP-1384 dispatched via FastFreight (7/5/2026)</li>
    </ul>
</div>
