@page "/Settings"
@model WMSys.Pages.sidemenu.SettingsModel
@{
    ViewData["Title"] = "Settings";
}

<h1>Settings</h1>

<!-- Account Settings -->
<section class="settings-section">
    <h3>Account</h3>
    <div class="form-group">
        <label>Username</label>
        <input type="text" class="form-control" value="Admin" readonly />
    </div>
    <div class="form-group">
        <label>Email</label>
        <input type="email" class="form-control" value="admin@example.com" />
    </div>
    <button class="btn btn-primary">Update Account</button>
</section>

<hr />

<!-- Preferences -->
<section class="settings-section">
    <h3>Preferences</h3>
    <div class="form-check">
    <input class="form-check-input" type="checkbox" id="darkModeToggle">
    <label class="form-check-label" for="darkModeToggle">Enable Dark Mode</label>
</div>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="notifications" checked>
        <label class="form-check-label" for="notifications">Enable Notifications</label>
    </div>
</section>

<hr />

<!-- Security -->
<section class="settings-section">
    <h3>Security</h3>
    <div class="form-group">
        <label>Change Password</label>
        <input type="password" class="form-control" placeholder="New Password" />
    </div>
    <button class="btn btn-warning">Update Password</button>
</section>
