@page "/Locations"
@model WMSys.Pages.sidemenu.LocationsModel
@{
    ViewData["Title"] = "Storage Locations";
}

<div class="container-fluid py-4">
    <h1 class="fw-bold mb-4">Storage Locations</h1>

    <!-- Zone Summary -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="metric-box up">
                <h4>Zone A — Electronics</h4>
                <p>4 aisles</p>
                <p>83% occupancy</p>
                <p>5/6 bins occupied</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="metric-box up">
                 <h4>Zone B — Furniture</h4>
                <p>3 aisles</p>
                <p>67% occupancy</p>
                <p>2/3 bins occupied</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="metric-box down">
                <h4>Zone C — Office Supplies</h4>
                <p>3 aisles</p>
                <p>50% occupancy</p>
                <p>1/2 bins occupied</p>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="metric-box alert">
                <h4>Zone D — Safety Equipment</h4>
                <p>2 aisles</p>
                <p>100% occupancy</p>
                <p>1/1 bins occupied</p>
            </div>
        </div>
    </div>
</div>


    <!-- Bin Locations Table -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-white fw-semibold">
            Bin Locations
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0 locations-table">
                <thead class="table-light">
                    <tr>
                        <th>Location Code</th>
                        <th>Zone</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Occupancy</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>A-01-01</td>
                        <td>A</td>
                        <td>Wireless Mouse</td>
                        <td>620</td>
                        <td class="status occupied">Occupied</td>
                    </tr>
                    <tr>
                        <td>A-01-02</td>
                        <td>A</td>
                        <td>Wireless Mouse</td>
                        <td>620</td>
                        <td class="status occupied">Occupied</td>
                    </tr>
                    <tr>
                        <td>A-01-03</td>
                        <td>A</td>
                        <td>Mechanical Keyboard</td>
                        <td>580</td>
                        <td class="status occupied">Occupied</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
