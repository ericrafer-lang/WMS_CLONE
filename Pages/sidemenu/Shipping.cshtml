@page "/Shipping"
@model WMSys.Pages.sidemenu.ShippingModel
@{
    ViewData["Title"] = "Shipping Management";
}

<h1>Shipping Management</h1>

<!-- Summary Boxes -->
<div class="shipping-summary">
    <div class="summary-box">Ready to Ship: <strong>2</strong></div>
    <div class="summary-box">In Transit: <strong>2</strong></div>
    <div class="summary-box">Delivered: <strong>2</strong></div>
    <div class="summary-box">Total Active: <strong>8</strong></div>
    <div class="new-shipment">
        <button class="btn btn-primary">+ Create Shipment</button>
    </div>
</div>

<!-- Filter Tabs -->
<div class="shipping-filters">
    <button class="filter-btn active">All</button>
    <button class="filter-btn">Picked</button>
    <button class="filter-btn">Packed</button>
    <button class="filter-btn">Shipped</button>
    <button class="filter-btn">Delivered</button>
</div>

<!-- Table -->
<table class="shipping-table">
    <thead>
        <tr>
            <th>Shipment ID</th>
            <th>Order</th>
            <th>Customer</th>
            <th>Items</th>
            <th>Carrier</th>
            <th>Tracking</th>
            <th>Destination</th>
            <th>Status</th>
        </tr>
