@page "/Reports"
@model WMSys.Pages.sidemenu.ReportsModel
@{
    ViewData["Title"] = "Inventory Reports";
}

<h1>Inventory Report</h1>

<!-- Action Buttons -->
<div class="report-actions mb-3">
    <button class="btn btn-primary">Inventory Report</button>
    <button class="btn btn-success">Export CSV</button>
    <button class="btn btn-secondary">Print / PDF</button>
</div>

<!-- Chart -->
<div class="chart-container mb-4">
    <canvas id="inventoryChart"></canvas>
</div>

<!-- Search -->
<div class="mb-3">
    <input type="text" id="searchInput" class="form-control" placeholder="Search inventory...">
</div>

<!-- Table -->
<table class="report-table table table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Product</th>
            <th>Category</th>
            <th>Qty</th>
            <th>Unit</th>
            <th>Min Stock</th>
            <th>Quality</th>
            <th>Price</th>
        </tr>
    </thead>
    <tbody id="reportTableBody">
        <tr>
            <td>PRD-001</td>
            <td>Circuit Board A1</td>
            <td>Electronics</td>
            <td>250</td>
            <td>pcs</td>
            <td>50</td>
            <td>Good</td>
            <td>$12.50</td>
        </tr>
        <tr>
            <td>PRD-002</td>
            <td>LED Display Panel</td>
            <td>Electronics</td>
            <td>30</td>
            <td>pcs</td>
            <td>40</td>
            <td>Good</td>
            <td>$89.99</td>
        </tr>
        <tr>
            <td>PRD-003</td>
            <td>Steel Sheets 4mm</td>
            <td>Raw Materials</td>
            <td>500</td>
            <td>kg</td>
            <td>100</td>
            <td>Good</td>
            <td>$3.20</td>
        </tr>
        <tr>
            <td>PRD-004</td>
            <td>Copper Wire 2mm</td>
            <td>Raw Materials</td>
            <td>15</td>
            <td>kg</td>
            <td>50</td>
            <td>Good</td>
            <td>$8.75</td>
        </tr>
    </tbody>
</table>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Chart.js setup
        const ctx = document.getElementById('inventoryChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Electronics', 'Raw Materials', 'Packaging', 'Safety Equipment', 'Office Supplies'],
                datasets: [{
                    label: 'Quantity',
                    data: [280, 515, 400, 150, 90],
                    backgroundColor: ['#3498db', '#2ecc71', '#f39c12', '#e74c3c', '#9b59b6']
                }]
            }
        });

        // Search filter
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#reportTableBody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
