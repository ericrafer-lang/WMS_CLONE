@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse Management System</title>
    <script type="importmap"></script>

    <!-- Font Awesome -->
    <script src="https://kit.fontawesome.com/84e1b825f8.js" crossorigin="anonymous"></script>
    <!-- taiwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    @*   <link rel="stylesheet" href="~/practice_for_wms.styles.css" asp-append-version="true" /> *@

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

</head>
<body class="flex min-h-screen">
    <div class="flex min-h-screen w-screen">

        <aside class="w-72 bg-[#0E1830] text-white flex flex-col">

            @* LOGO *@
            <div class="flex items-center p-3 w-full border-b border-gray-800">
                <div class="mr-2 bg-[#1E57D9] color-[#FFFFFF] p-2 rounded-xl">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <div class="flex-column justify-center text-lg font-bold">WMS</div>
            </div>

            @* NAV SECTION *@
            <section class="p-2.5">
                <ul class="sidebar-list">
                    <li class="sidebar-options @(currentPage == "/Index" ? "sidebar-selected" : "")">
                        <a asp-page="/Index" class="text-white">
                            <i class="fa-solid fa-grip"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentPage == "/Product" ? "sidebar-selected" : "")">
                        <a asp-page="/Product">
                            <i class="fa-solid fa-box-open"></i>
                            <span>Product</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentPage == "/Supplier" ? "sidebar-selected" : "")">
                        <a asp-page="/Supplier">
                            <i class="fa-solid fa-truck"></i>
                            <span>Supplier</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/Branches" ? "sidebar-selected" : "")">
                        <a asp-page="/Branches">
                            <i class="fa-solid fa-city"></i>
                            <span> Branches</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/UserManagement" ? "sidebar-selected" : "")">
                        <a asp-page="/UserManagement">
                            <i class="fa-solid fa-users"></i>
                            <span> User Management</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/ProductRequest" ? "sidebar-selected" : "")">
                        <a asp-page="/ProductRequest">
                            <i class="fa-solid fa-clipboard-list"></i>
                            <span> Product Request</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/Deliveries" ? "sidebar-selected" : "")">
                        <a asp-page="/Deliveries">
                            <i class="fa-solid fa-location-dot"></i>
                            <span> Deliveries</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/Orders" ? "sidebar-selected" : "")">
                        <a asp-page="/Orders">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span> Orders</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/ActivityLog" ? "sidebar-selected" : "")">
                        <a asp-page="/ActivityLog">
                            <i class="fa-solid fa-chart-line"></i>
                            <span> Activity Log</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/Report" ? "sidebar-selected" : "")">
                        <a asp-page="/Report">
                            <i class="fa-solid fa-file-lines"></i>
                            <span>Report</span>
                        </a>
                    </li>
                    <li class="@(currentPage == "/Notification" ? "sidebar-selected" : "")">
                        <a asp-page="/Notification">
                            <i class="fa-solid fa-bell"></i>
                            <span> Notification</span>
                        </a>
                    </li>
                </ul>
            </section>

            <section class="mt-auto border-t border-gray-800 p-4">

                <div class="py-2.5 px-3">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </div>

            </section>
        </aside>

        <div class="flex flex-col w-full">

            <header class="h-16 w-full bg-white flex justify-between items-center px-6 border-b border-gray-200 text-sm ">

                <div class="flex justify-between w-full ">
                    <div class="p-3 font-inter">
                        <div class="font-semibold color-gray-400">Welcome back, Juan</div>
                        <div class="font-light text-sm">Administrator</div>
                    </div>

                    <div class="flex items-center p-3 gap-4">
                        <i class="fa-regular fa-bell fa-xl"></i>
                        <i class="fa-solid fa-gear fa-xl"></i>
                    </div>
                </div>
            </header>

            <main role="main" class="flex-1">
                @RenderBody()
            </main>
        </div>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
