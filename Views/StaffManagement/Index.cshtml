@{
    ViewData["Title"] = "Staff Management";
}

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Staff Management
            </p>

            <p class="">
                3 warehouse staff
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">

            <button class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2" data-modal="staffModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <line x1="19" x2="19" y1="8" y2="14" />
                    <line x1="22" x2="16" y1="11" y2="11" />
                </svg>
                <span>Invite Staff</span>
            </button>

            <!-- Modal Overlay -->
            <div id="staffModal"
                 class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">

                <!-- Modal -->
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">

                    <h2 class="text-2xl font-semibold mb-6">Add New Staff Member</h2>

                    <form method="post">

                        <div class="grid grid-cols-2 gap-4">

                            <div class="col-span-2">
                                <label class="font-medium">Email Address <span class="text-red-500">*</span></label>
                                <input type="email" placeholder="staff@example.com"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" required />
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Full Name <span class="text-red-500">*</span></label>
                                <input type="text" placeholder="e.g. Juan dela Cruz"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            <div>
                                <label class="font-medium">Job Role</label>
                                <select class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option>General Warehouse</option>
                                    <option>Supervisor</option>
                                    <option>Driver</option>
                                </select>
                            </div>

                            <div>
                                <label class="font-medium">Phone Number</label>
                                <input type="tel" placeholder="+63 912 345 6789"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            <div>
                                <label class="font-medium">Shift</label>
                                <input type="text" placeholder="e.g. Morning / Night"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            <div>
                                <label class="font-medium">Branch Assignment</label>
                                <input type="text" placeholder="e.g. Main Warehouse"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Notes</label>
                                <textarea placeholder="Any additional info..."
                                          class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
                            </div>

                        </div>

                        <div class="flex justify-end gap-3 mt-6">
                            <button type="button"
                                    id="cancelModal"
                                    class="close-modal px-4 py-2 border rounded-lg">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="bg-blue-600 text-white px-4 py-2 rounded-lg">
                                Send Invite
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="table-product-name">Axcel</td>
                        <td>axcel@devsupreme.com</td>
                        <td>
                            <span class="badge admin">
                                Admin
                            </span>
                        </td>
                        <td>
                            Munting Ilog
                        </td>
                        <td>
                            <span class="badge active">
                                Active
                            </span>
                        </td>
                        <td>
                            <div class="flex justify-center items-center gap-3 h-full">
                                <button>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                </button>
                                <button class="btndelete">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="table-product-name">Solis</td>
                        <td>solis@devsupreme.com</td>
                        <td>
                            <span class="badge supervisor">
                                Supervisor
                            </span>
                        </td>
                        <td>
                            Munting Ilog
                        </td>
                        <td>
                            <span class="badge active">
                                Active
                            </span>
                        </td>
                        <td>
                            <div class="flex justify-center items-center gap-3 h-full">
                                <button>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                </button>
                                <button class="btndelete">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td class="table-product-name">Clarence</td>
                        <td>clarence@devsupreme.com</td>
                        <td>
                            <span class="badge staff">
                                Staff
                            </span>
                        </td>
                        <td>
                            Munting Ilog
                        </td>
                        <td>
                            <span class="badge inactive">
                                Inactive
                            </span>
                        </td>
                        <td>
                            <div class="flex justify-center items-center gap-3 h-full">
                                <button>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                </button>
                                <button class="btndelete">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>