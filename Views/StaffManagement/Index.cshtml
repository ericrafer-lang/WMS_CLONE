@using practice_for_wms.Models.ViewModels.StaffManagement
@using practice_for_wms.Models.Entities
@model StaffManagementIndexViewModel

@{
    ViewData["Title"] = "Staff Management";
}

<div class="p-4 lg:p-6">
    @* HEADING *@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Staff Management
            </p>
            <p>
                <p>
                    @Model.Staff.Count staff member@(Model.Staff.Count == 1 ? "" : "s")
                    @(Model.IsAdmin ? "across all branches" : $"in {Model.CurrentBranch?.BranchName}")
                </p>
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">
            <button class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2 hovering" data-modal="staffModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <line x1="19" x2="19" y1="8" y2="14" />
                    <line x1="22" x2="16" y1="11" y2="11" />
                </svg>
                <span>Invite Staff</span>
            </button>

            <!-- Add Staff Modal -->
            <div id="staffModal" class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                    <h2 class="text-2xl font-semibold mb-6">Add New Staff Member</h2>

                    <form asp-controller="StaffManagement" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div class="grid grid-cols-2 gap-4">
                            <div class="col-span-2">
                                <label class="font-medium">Email Address <span class="text-red-500">*</span></label>
                                <input asp-for="CreateStaff.Email" type="email" placeholder="staff@example.com"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" required />
                                <span asp-validation-for="CreateStaff.Email" class="text-red-500 text-sm"></span>
                            </div>

                            <div>
                                <label class="font-medium">First Name <span class="text-red-500">*</span></label>
                                <input asp-for="CreateStaff.FirstName" type="text" placeholder="e.g. Juan"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                <span asp-validation-for="CreateStaff.FirstName" class="text-red-500 text-sm"></span>
                            </div>

                            <div>
                                <label class="font-medium">Last Name <span class="text-red-500">*</span></label>
                                <input asp-for="CreateStaff.LastName" type="text" placeholder="e.g. dela Cruz"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                <span asp-validation-for="CreateStaff.LastName" class="text-red-500 text-sm"></span>
                            </div>

                            <div>
                                <label class="font-medium">Job Role</label>
                                <select asp-for="CreateStaff.Role" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                    <option value="general warehouse">General Warehouse</option>
                                    <option value="supervisor">Supervisor</option>
                                    <option value="driver">Driver</option>
                                </select>
                            </div>

                            <div>
                                <label class="font-medium">Phone Number</label>
                                <input asp-for="CreateStaff.PhoneNumber" type="tel" placeholder="+63 912 345 6789"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            <div>
                                <label class="font-medium">Shift</label>
                                <input asp-for="CreateStaff.Shift" type="text" placeholder="e.g. Morning / Night"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                            </div>

                            @if (Model.IsAdmin)
                            {
                                <div>
                                    <label class="font-medium">Branch Assignment <span class="text-red-500">*</span></label>
                                    <select asp-for="CreateStaff.BranchId" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                        <option value="">Select branch...</option>
                                        @foreach (var branch in Model.Branches)
                                        {
                                            <option value="@branch.Id">@branch.BranchName</option>
                                        }
                                    </select>
                                    <span asp-validation-for="CreateStaff.BranchId" class="text-red-500 text-sm"></span>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <label class="font-medium">Branch Assignment</label>
                                    <input type="text" value="@Model.CurrentBranch?.BranchName" disabled
                                           class="w-full rounded-lg border border-gray-300 p-2 shadow-sm bg-gray-100" />
                                </div>
                            }

                            <div class="col-span-2">
                                <label class="font-medium">Notes</label>
                                <textarea asp-for="CreateStaff.Notes" placeholder="Any additional info..."
                                          class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
                            </div>
                        </div>

                        <div class="flex justify-end gap-3 mt-6">
                            <button type="button" class="close-modal px-4 py-2 border rounded-lg hovering">Cancel</button>
                            <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hovering">Send Invite</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* TABLE *@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        <div class="w-full">
            <table class="product-table w-full border-collapse">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Staff.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center p-4">No staff found.</td>
                        </tr>
                    }
                    @foreach (var staff in Model.Staff)
                    {
                        <tr>
                            <td class="table-product-name">@staff.FirstName @staff.LastName</td>
                            <td>@staff.Email</td>
                            <td>
                                <span class="badge @staff.Role.ToLower().Replace(" ", "-")">@staff.Role</span>
                            </td>
                            <td>@staff.Branch?.BranchName</td>
                            <td>
                                <span class="badge @(staff.Status == UserStatus.Active ? "active" : staff.Status == UserStatus.Inactive ? "inactive" : "pending")">
                                    @staff.Status
                                </span>
                            </td>
                            <td>
                                <div class="flex justify-center items-center gap-3 h-full">
                                    <button class="open-modal flex gap-2 hovering" data-modal="editModal-@staff.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                    </button>

                                    <!-- Edit Modal (one per row, unique id) -->
                                    <div id="editModal-@staff.Id" class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50 text-left">
                                        <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                                            <h2 class="text-2xl font-semibold mb-6">Edit Staff Member</h2>

                                            <form asp-controller="StaffManagement" asp-action="Update" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="UpdateStaff.Id" value="@staff.Id" />

                                                <div class="grid grid-cols-2 gap-4">
                                                    <div class="col-span-2">
                                                        <label class="font-medium">Email Address <span class="text-red-500">*</span></label>
                                                        <input name="UpdateStaff.Email" type="email" value="@staff.Email"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" required />
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">First Name <span class="text-red-500">*</span></label>
                                                        <input name="UpdateStaff.FirstName" type="text" value="@staff.FirstName"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">Last Name <span class="text-red-500">*</span></label>
                                                        <input name="UpdateStaff.LastName" type="text" value="@staff.LastName"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">Job Role</label>
                                                        <select name="UpdateStaff.Role" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                                            @foreach (var role in new[] { "general warehouse", "supervisor", "driver" })
                                                            {
                                                                <option value="@role" selected="@(staff.Role == role)">@System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(role)</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">Phone Number</label>
                                                        <input name="UpdateStaff.PhoneNumber" type="tel" value="@staff.PhoneNumber"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">Shift</label>
                                                        <input name="UpdateStaff.Shift" type="text" value="@staff.Shift"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                                                    </div>

                                                    <div>
                                                        <label class="font-medium">Status</label>
                                                        <select name="UpdateStaff.Status" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                                            @foreach (var status in Enum.GetValues<UserStatus>())
                                                            {
                                                                <option value="@status" selected="@(staff.Status == status)">@status</option>
                                                            }
                                                        </select>
                                                    </div>

                                                    @if (Model.IsAdmin)
                                                    {
                                                        <div>
                                                            <label class="font-medium">Branch Assignment</label>
                                                            <select name="UpdateStaff.BranchId" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                                                                @foreach (var branch in Model.Branches)
                                                                {
                                                                    <option value="@branch.Id" selected="@(staff.BranchId == branch.Id)">@branch.BranchName</option>
                                                                }
                                                            </select>
                                                        </div>
                                                    }

                                                    <div class="col-span-2">
                                                        <label class="font-medium">Notes</label>
                                                        <textarea name="UpdateStaff.Notes"
                                                                  class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none">@staff.Notes</textarea>
                                                    </div>
                                                </div>

                                                <div class="flex justify-end gap-3 mt-6">
                                                    <button type="button" class="close-modal px-4 py-2 border rounded-lg hovering">Cancel</button>
                                                    <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded-lg hovering">Update</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                    <form asp-controller="StaffManagement" asp-action="Delete" method="post" onsubmit="return confirm('Remove @staff.FirstName @staff.LastName from staff?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@staff.Id" />
                                        <button type="submit" class="btndelete hovering">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>