@model List<practice_for_wms.Models.Entities.Product>
@{
    ViewData["Title"] = "Product";
}

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Products
            </p>

            <p class="">
                @Model.Count Products in Inventory
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">
            <select class="flex flex-column btn-style gap-3 shadow-md px-5">
                <option>All Categories</option>
                <option>Safety Equipment</option>
                <option>Packaging</option>
            </select>

            <button class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2" data-modal="productModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                <span>Add Product</span>
            </button>
            
            <!-- Modal Overlay -->
            <div id="productModal"
                 class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">

                <!-- Modal -->
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                    <h2 class="text-2xl font-semibold mb-6">Add Product</h2>

                    <form method="post">

                        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-3">

                            <div class="col-span-2">
                                <label class="font-medium">Product Name</label>
                                <input placeholder="Enter Product Name" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div>
                                <label>Product ID</label>
                                <input placeholder="Enter Product ID" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div>
                                <label>Barcode?</label>
                                <input placeholder="Enter Product Barcode" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div>
                                <label>Category</label>
                                <select class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option>Select</option>
                                </select>
                            </div>

                            <div>
                                <label>Unit</label>
                                <select class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option>pcs</option>
                                    <option>box</option>
                                </select>
                            </div>

                            <div>
                                <label>Quantity</label>
                                <input placeholder="Enter Product Quantity" type="number"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                       min="0"/>
                            </div>

                            @* <div>
                                <label>Min Stock</label>
                                <input type="number"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div> *@

                            <div>
                                <label>Price</label>
                                <input placeholder="Enter Product Price" type="number"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" 
                                       min="0"/>
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Expiration Date</label>
                                <input type="date"class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label>Description</label>
                                <textarea placeholder="Enter Product Description" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>

                        </div>

                        @* buttons *@
                        <div class="flex justify-end gap-3 mt-6">
                            
                            <button type="button"
                                    id="cancelModal"
                                    class="close-modal btn-style px-4 py-2 border rounded-lg">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="bg-blue-600 text-white px-4 py-2 rounded-lg">
                                Create
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Supplier</th>
                        <th>Category</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Quality</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>TRD-001</td>
                        <td class="table-product-name">Circuit Board A1</td>
                        <td>SOLIS MENDEZ WAREHOUSE</td>
                        <td>Electronics</td>
                        <td>250 pcs</td>
                        <td>520</td>
                        <td>
                            <span class="badge good">
