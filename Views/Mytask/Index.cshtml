@model practice_for_wms.Models.MyTaskIndexViewModel
@{
    ViewData["Title"] = "Mytask";
}
<div class="p-4 lg:p-6">
    <h1 class="text-2xl font-bold">My Task</h1>

    <p class="text-sm mt-1 text-[#65758B]">
        @Model.ActiveTasks.Count active task@(Model.ActiveTasks.Count == 1 ? "" : "s")
    </p>

    <p class="text-md font-semibold mt-8 text-[#65758B]">ACTIVE</p>

    @foreach (var task in Model.ActiveTasks)
    {
        <div class="task-card">
            <div class="flex justify-between items-center">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <h3 class="text-l font-semibold">@task.Title</h3>
                        <span class="bg-[#DBEAFE] text-[#1D4ED8] font-semibold rounded-full px-3 py-1 text-xs">
                            @task.Status
                        </span>
                        @{
                            var priorityBg = task.Priority?.ToLower() switch {
                                "high" => "bg-[#fee2e2] text-[#B91C1C]",
                                "medium" => "bg-[#fef3c7] text-[#b45309]",
                                "low" => "bg-[#D1FAE5] text-[#047857]",
                                _ => "bg-[#f3f4f6] text-[#374151]"
                            };
                        }
                        <span class="@priorityBg font-semibold rounded-full px-3 py-1 text-xs">
                            @task.Priority
                        </span>
                    </div>
                    <p class="text-sm text-gray-500">@task.Description</p>
                </div>

                <form asp-action="UpdateStatus" method="post"
                      onsubmit="return confirm('Are you sure you want to mark this task as completed?');">
                    <input type="hidden" name="id" value="@task.Id" />
                    <input type="hidden" name="status" value="Completed" />
                    <button type="submit" class="btn-complete">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        Mark Completed
                    </button>
                </form>
            </div>
        </div>
    }

    <p class="text-md font-semibold mt-8 text-[#65758B]">COMPLETED</p>

    @foreach (var task in Model.CompletedTasks)
    {
        <div class="task-card" style="opacity: 0.75;">
            <div class="flex justify-between items-center">
                <div>
                    <div class="flex items-center gap-3 mb-2">
                        <h3 class="text-l font-semibold">@task.Title</h3>
                        <span class="bg-[#D1FAE5] text-[#047857] font-semibold rounded-full px-3 py-1 text-xs">
                            @task.Status
                        </span>
                        @{
                            var compPriorityBg = task.Priority?.ToLower() switch {
                                "high" => "bg-[#fee2e2] text-[#B91C1C]",
                                "medium" => "bg-[#fef3c7] text-[#b45309]",
                                "low" => "bg-[#D1FAE5] text-[#047857]",
                                _ => "bg-[#f3f4f6] text-[#374151]"
                            };
                        }
                        <span class="@compPriorityBg font-semibold rounded-full px-3 py-1 text-xs">
                            @task.Priority
                        </span>
                    </div>
                    <p class="text-sm text-gray-500">@task.Description</p>
                </div>

                <span class="text-sm text-emerald-600 font-semibold flex items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    Done
                </span>
            </div>
        </div>
    }
</div>