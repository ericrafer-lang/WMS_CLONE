@model List<practice_for_wms.Models.Entities.Supplier>
@{
    ViewData["Title"] = "Supplier";
}

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Supplier
            </p>

            <p class="">
                @Model.Count Suppliers
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">
            <select id="statusFilter" class="flex flex-column btn-style gap-3 shadow-md px-5">
                <option value="">All</option>
                <option value="active">Active list</option>
                <option value="inactive">Inactive list</option>
            </select>

            <button onclick="document.getElementById('supplierModal').classList.remove('hidden')" class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2" data-modal="supplierModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                <span>Add Supplier</span>
            </button>

            <!-- Modal Overlay -->
            <div id="supplierModal"
                 class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50 ">

                <!-- Modal -->
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative overflow-y-auto">
                    <div class="modal-header">
                        <div class="modal-header-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        </div>
                        <div class="modal-header-text">
                            <h2>Add New Supplier</h2>
                            <p>Fill in the supplier information below.</p>
                        </div>
                        <button type="button" class="modal-close-btn close-modal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    </div>

                    <form asp-controller="Supplier" asp-action="Add" method="post">
                        @Html.AntiForgeryToken()
                        <div class="grid grid-cols-1 gap-4">

                            <div class="col-span-2">
                                <label class="font-medium">Supplier Name</label>
                                <input name="supplierName" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label>Contact Person</label>
                                <input name="contactPerson" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label>Email</label>
                                <input name="supplierEmail" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label>Phone</label>
                                <input name="phone"class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label>Address</label>
                                <input name="address"class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <div class="flex items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package-icon lucide-package"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" /><polyline points="3.29 7 12 12 20.71 7" /><path d="m7.5 4.27 9 5.15" /></svg>
                                    <label class="ml-1 text-sm">Product Supplied</label>
                                </div>
                                <input type="text"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"
                                       placeholder="Search product.."/>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <a asp-action="Index" class="btn-secondary">Cancel</a>
                            <button type="submit" class="btn-primary">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                Create Supplier
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input id="searchInput" placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Name</th>
                        <th>Contact</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var supplier in Model)
                    {
                        <tr data-status="@supplier.Status.ToLower()" data-name="@supplier.SupplierName.ToLower()">
                            <td>@supplier.SupplierName</td>
                            <td class="table-product-name">@supplier.ContactPerson</td>
                            <td>@supplier.SupplierEmail</td>
                            <td>@supplier.Phone</td>
                            <td>
                                <span class="badge @(supplier.Status.ToLower() == "active" ? "active" : "inactive")">
                                    @supplier.Status
                                </span>
                            </td>

                            @*Edit Modal*@
                            <td>
                            <div class="flex justify-center items-center gap-3 h-full">
                                    <button class="open-modal flex gap-2" data-modal="editModal-@supplier.Id">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                    </button>

                                    <div id="editModal-@supplier.Id"
                                         class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">
                                        <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                                            <div class="modal-header">
                                                <div class="modal-header-icon">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"/></svg>
                                                </div>
                                                <div class="modal-header-text">
                                                    <h2>Edit Supplier</h2>
                                                    <p>Update the supplier details below.</p>
                                                </div>
                                                <button type="button" class="modal-close-btn close-modal">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                                </button>
                                            </div>

                                            <form asp-controller="Supplier" asp-action="Update" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@supplier.Id" />

                                                <div class="grid grid-cols-1 gap-4 lg:grid-cols-2 lg:gap-3">
                                                    <div class="col-span-2">
                                                        <label class="font-medium">Supplier Name</label>
                                                        <input name="name" value="@supplier.SupplierName"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                                                    </div>

                                                    <div>
                                                        <label>Contact Person</label>
                                                        <input name="contactPerson" value="@supplier.ContactPerson"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                                                    </div>

                                                <div>
                                                        <label>Supplier Email</label>
                                                        <input name="supplierEmail" value="@supplier.SupplierEmail"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                                                    </div>

                                                    <div>
                                                        <label>Phone</label>
                                                        <input name="phone" value="@supplier.Phone"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                                                    </div>

                                                    <div>
                                                        <label>Address</label>
                                                        <input name="address" value="@supplier.Address"
                                                               class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                                                    </div>

                                                    <div>
                                                        <label>Status</label>
                                                        <select name="status" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                                                            <option value="Active" selected="@(supplier.Status == "Active" ? "selected" : "")">Active</option>
                                                            <option value="Inactive" selected="@(supplier.Status == "Inactive" ? "selected" : "")">Inactive</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="close-modal btn-secondary">Cancel</button>
                                                    <button type="submit" class="btn-primary">Save Changes</button>
                                                </div>
                                                </form>
                                            </div>
                                        </div>

                                        @*Delete Modal*@
                                        <div class="flex justify-center items-center gap-3 h-full">
                                            <form asp-action="Delete" method="post" style="display:inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@supplier.Id" />
                                                <button class="btndelete" type="submit" onclick="return confirm('Delete this supplier?')">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                </div>
                                </td>
                            <td>
                                
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div> 
</div>

<script>
    const statusFilter = document.getElementById('statusFilter');
    const searchInput = document.getElementById('searchInput');
    const rows = document.querySelectorAll('.product-table tbody tr');

    function applyFilters() {
        const statusVal = statusFilter.value;
        const searchVal = searchInput.value.trim().toLowerCase();

        rows.forEach(row => {
            const matchesStatus = !statusVal || row.dataset.status === statusVal;
            const matchesSearch = !searchVal || row.dataset.name.includes(searchVal);
            row.style.display = (matchesStatus && matchesSearch) ? '' : 'none';
        });
    }

    statusFilter.addEventListener('change', applyFilters);
    searchInput.addEventListener('input', applyFilters);
</script>