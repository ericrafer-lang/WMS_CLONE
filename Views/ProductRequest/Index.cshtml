@model List<practice_for_wms.Models.Entities.Request>
@using System.Text.Json
@{
    ViewData["Title"] = "Product Management";
}

<div class="p-4 lg:p-6">
    @if (TempData["Error"] != null)
    {
        <div style="background:#FEE2E2; color:#B91C1C; padding:12px 16px; border-radius:10px; margin-bottom:16px;">
            @TempData["Error"]
        </div>
    }
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Products Request
            </p>

            <p class="">
                @Model.Count(r => r.Status == "Pending") Pending Requests
            </p>
        </div>

    </div>

    <!-- Approval Modal Overlay -->
    <div id="approveModal" class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50 p-4">
        <!-- Modal -->
        <div class="modal bg-white rounded-xl shadow-xl w-full max-w-lg p-5 relative max-h-[95vh] overflow-y-auto">
            <div class="modal-header mb-3 pb-3">
                <div class="modal-header-icon text-green-600 bg-green-100 rounded-full p-2 mb-2 inline-block">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                </div>
                <div class="modal-header-text">
                    <h2 class="font-bold text-lg">Approve Product Request</h2>
                    <p class="text-sm text-gray-500">Fill in the necessary details before approving this request.</p>
                </div>
                <button type="button" id="approveModalClose"class="modal-close-btn close-modal absolute top-4 right-4 text-gray-400 hover:text-gray-600">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                </button>
            </div>

            <form id="approveForm" asp-action="Approve" asp-controller="ProductRequest" method="post">
                <input type="hidden" name="id" id="approveRequestId" value="" />
                <div class="mb-3">
                    <label class="form-label text-sm mb-1 block">Supplier <span class="text-red-500">*</span></label>
                    <select name="supplierId" id="approveSupplierSelect" class="modern-select w-full" style="padding: 8px 12px; height: 42px; border: 1px solid #d1d5db; border-radius: 6px;">
                        <option value="">Select supplier</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-sm mb-1 block">Quantity Approved <span class="text-red-500">*</span></label>
                    <input type="number" name="quantityApproved" id="approveQuantityInput" min="1" required
                           class="form-control mb-0 w-full" style="padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; height: 42px;" />
                </div>

                <div class="mb-4">
                    <label class="form-label text-sm mb-1 block">Approval Remarks / Notes</label>
                    <textarea name="reviewNotes" rows="3" placeholder="Any specific instructions for ordering..."
                              class="form-control mb-0 w-full" style="padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; resize: none;"></textarea>
                </div>

                <div class="modal-footer mt-4 pt-4 border-t border-gray-100 flex justify-end gap-2">
                    <button type="button" id="approveModalCancel" class="close-modal bg-gray-100 text-gray-700 hover:bg-gray-200 px-4 py-2 rounded-lg font-medium transition-colors">Cancel</button>
                    <button type="submit" class="bg-green-600 text-white hover:bg-green-700 px-4 py-2 rounded-lg font-medium transition-colors">Confirm Approval</button>
                </div>
            </form>
        </div>
    </div>

    <form id="rejectForm" asp-action="Reject" asp-controller="ProductRequest" method="post" style="display:none;">
        <input type="hidden" name="id" id="rejectRequestId" value="" />
    </form>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Product</th>
                        <th>Supplier</th>
                        <th>Qty</th>
                        <th>Priority</th>
                        <th>Reason</th>
                        <th>Requested By</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" style="text-align:center; padding: 20px;">No product requests yet.</td>
                        </tr>
                    }
                    @foreach (var req in Model)
                    {
                        <tr>
                            <td class="table-product-name">@req.Product?.Name</td>
                            <td>@(req.Product?.Supplier?.SupplierName ?? "—")</td>
                            <td>@req.Quantity @req.Unit</td>
                            <td><span class="badge @req.Priority.ToLower()">@req.Priority</span></td>
                            <td>@req.Reason</td>
                            <td>@req.RequestedBy?.FirstName @req.RequestedBy?.LastName</td>
                            <td><span class="badge @req.Status.ToLower()">@req.Status</span></td>
                            <td>@(req.ReviewNotes ?? "—")</td>
                            <td>
                                @if (req.Status == "Pending")
                                {
                                    <div class="flex justify-center items-center gap-3 h-full">
                                        <button type="button" class="hovering open-approve-modal text-green-600 hover:text-green-800"
                                                data-id="@req.id" data-qty="@req.Quantity" data-product="@req.ProductId" title="Approve Request">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-circle"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
                                        </button>
                                        <button type="button" class="hovering reject-btn text-red-600 hover:text-red-800"
                                                data-id="@req.id" title="Reject Request">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x-circle"><circle cx="12" cy="12" r="10" /><path d="m15 9-6 6" /><path d="m9 9 6 6" /></svg>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#9CA3AF;">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const approveModal = document.getElementById('approveModal');
        const approveIdInput = document.getElementById('approveRequestId');
        const approveQtyInput = document.getElementById('approveQuantityInput');
        const supplierSelect = document.getElementById('approveSupplierSelect');
        const closeBtn = document.getElementById('approveModalClose');
        const cancelBtn = document.getElementById('approveModalCancel');
        const rejectForm = document.getElementById('rejectForm');
        const rejectIdInput = document.getElementById('rejectRequestId');

        const productSuppliers = @Html.Raw(JsonSerializer.Serialize(ViewBag.ProductSuppliers));

        function showApproveModal() {
            approveModal.classList.remove('hidden');
            approveModal.classList.add('flex');
        }
        function hideApproveModal() {
            approveModal.classList.add('hidden');
            approveModal.classList.remove('flex');
        }

        document.querySelectorAll('.open-approve-modal').forEach(function(btn) {
            btn.addEventListener('click', function() {
                approveIdInput.value = btn.dataset.id;
                approveQtyInput.value = btn.dataset.qty;

                const productId = btn.dataset.product;
                const suppliers = productSuppliers[productId] || [];

                supplierSelect.innerHTML = '<option value="">Select supplier</option>';
                suppliers.forEach(function(s) {
                    const opt = document.createElement('option');
                    opt.value = s.id;
                    opt.textContent = s.name;
                    supplierSelect.appendChild(opt);
                });

                showApproveModal();
            });
        });

        document.querySelectorAll('.reject-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                if (confirm('Reject this request?')) {
                    rejectIdInput.value = btn.dataset.id;
                    rejectForm.submit();
                }
            });
        });

        closeBtn.addEventListener('click', hideApproveModal);
        cancelBtn.addEventListener('click', hideApproveModal);
        approveModal.addEventListener('click', function(e) {
            if (e.target === approveModal) hideApproveModal();
        });
    });
</script>