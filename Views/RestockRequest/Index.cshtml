@{
    ViewData["Title"] = "RestockRequest";
}

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Restock Requests
            </p>

            <p class="">
                0 requests
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">

            <button class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2 hovering" data-modal="orderModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-plus-icon lucide-plus"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                <span>New Request</span>
            </button>

            <!-- Modal Overlay -->
            <div id="orderModal"
                 class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50 p-4">

                <!-- Modal -->
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-5 relative max-h-[95vh] overflow-y-auto">
                    <div class="modal-header mb-3 pb-3">
                        <div class="modal-header-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        </div>
                        <div class="modal-header-text">
                            <h2>New Product Request</h2>
                            <p>Fill in the product request details below.</p>
                        </div>
                        <button type="button" class="modal-close-btn close-modal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    </div>

                    <form>
                        <div class="mb-3">
                            <label class="form-label text-sm mb-1">Product <span class="text-red-500">*</span></label>
                            <select class="modern-select" style="padding: 8px 12px; height: 42px;">
                                <option>Select product</option>
                            </select>
                        </div>

                        <div class="flex gap-3 mb-3">
                            <div class="w-1/2">
                                <label class="form-label text-sm mb-1">Quantity <span class="text-red-500">*</span></label>
                                <input type="number" value="1" class="form-control mb-0" style="padding: 8px 12px; border: 1px solid #d1d5db; background: #fff; height: 42px;" />
                            </div>
                            <div class="w-1/2">
                                <label class="form-label text-sm mb-1">Unit</label>
                                <select class="modern-select" style="padding: 8px 12px; height: 42px;">
                                    <option>pcs</option>
                                </select>
                            </div>
                        </div>

                        <div class="flex gap-3 mb-3">
                            <div class="w-1/2">
                                <label class="form-label text-sm mb-1">Priority</label>
                                <select class="modern-select" style="padding: 8px 12px; height: 42px;">
                                    <option>Medium</option>
                                </select>
                            </div>
                            <div class="w-1/2">
                                <label class="form-label text-sm mb-1">Expected Date</label>
                                <input type="date" class="form-control mb-0" style="padding: 8px 12px; border: 1px solid #d1d5db; background: #fff; height: 42px; color: #6b7280;" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-sm mb-1">Reason <span class="text-red-500">*</span></label>
                            <textarea rows="2" placeholder="Why is this product needed?" class="form-control mb-0" style="padding: 8px 12px; border: 1px solid #d1d5db; background: #fff; resize: none;"></textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label text-sm mb-1">Additional Notes</label>
                            <textarea rows="2" placeholder="Any special requirements, delivery instructions, etc." class="form-control mb-0" style="padding: 8px 12px; border: 1px solid #d1d5db; background: #fff; resize: none;"></textarea>
                        </div>

                        <div class="modal-footer mt-2 pt-4">
                            <button type="button" class="close-modal btn-secondary hovering" style="padding: 8px 16px;">Cancel</button>
                            <button type="button" class="btn-primary hovering" style="padding: 8px 16px;">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Product</th>
                        <th>Supplier</th>
                        <th>Qty</th>
                        <th>Priority</th>
                        <th>Reason</th>
                        <th>Requested By</th>
                        <th>Expected By</th>
                        <th>Status</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="table-product-name">LED Display Panel</td>
                        <td>fgdgdg</td>
                        <td>12</td>
                        <td>
                            <span class="badge medium">Medium</span>
                        </td>
                        <td>sdf</td>
                        <td>Clarence Mendoza</td>
                        <td>—</td>
                        <td>
                            <span class="badge approve">Approved</span>
                        </td>
                        <td>—</td>
                    </tr>
                    <tr>
                        <td class="table-product-name">Copper Wire 2mm</td>
                        <td>fgdgdg</td>
                        <td>1</td>
                        <td>
                            <span class="badge medium">Medium</span>
                        </td>
                        <td>wfrawf</td>
                        <td>Solis 98</td>
                        <td>—</td>
                        <td>
                            <span class="badge pending">Pending</span>
                        </td>
                        <td>—</td>
                    </tr>
                    <tr>
                        <td class="table-product-name">Copper Wire 2mm</td>
                        <td>fgdgdg</td>
                        <td>5</td>
                        <td>
                            <span class="badge medium">Medium</span>
                        </td>
                        <td>wanna aprob dis?</td>
                        <td>Solis 98</td>
                        <td>—</td>
                        <td>
                            <span class="badge rejected">Rejected</span>
                        </td>
                        <td>sample clarence</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>