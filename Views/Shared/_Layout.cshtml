@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Warehouse Management System</title>
    <script type="importmap"></script>

    <!-- taiwind CSS CDN -->
    <script src="https://cdn.jsdelivr.net/npm/@@tailwindcss/browser@4"></script>

    <!-- Stylesheets -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    @*   <link rel="stylesheet" href="~/practice_for_wms.styles.css" asp-append-version="true" /> *@

    <!-- Google Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">

</head>
<body class="flex min-h-screen">
    <div class="flex min-h-screen w-screen">

        <aside class="w-72 bg-[#0E1830] text-white flex flex-col">

            @* LOGO *@
            <div class="flex items-center p-3 w-full border-b border-gray-800">
                <div class="mr-2 bg-[#1E57D9] color-[#FFFFFF] p-2 rounded-xl">
                    <i class="fa-solid fa-warehouse"></i>
                </div>

                <div class="flex-column justify-center text-lg font-bold">WMS</div>
            </div>

            @* NAV SECTION *@
            <section class="p-2.5">
                <ul class="sidebar-list">
                    <li class="sidebar-options @(currentController == "Dashboard" ? "sidebar-selected" : "")">
                        <a asp-controller="Dashboard" asp-action="Index" class="text-white">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layout-dashboard-icon lucide-layout-dashboard"><rect width="7" height="9" x="3" y="3" rx="1" /><rect width="7" height="5" x="14" y="3" rx="1" /><rect width="7" height="9" x="14" y="12" rx="1" /><rect width="7" height="5" x="3" y="16" rx="1" /></svg>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Product" ? "sidebar-selected" : "")">
                        <a asp-controller="Product" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-package-icon lucide-package"><path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z" /><path d="M12 22V12" /><polyline points="3.29 7 12 12 20.71 7" /><path d="m7.5 4.27 9 5.15" /></svg>
                            <span>Product</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Supplier" ? "sidebar-selected" : "")">
                        <a asp-controller="Supplier" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-truck-icon lucide-truck"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" /></svg>
                            <span>Supplier</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Branches" ? "sidebar-selected" : "")">
                        <a asp-controller="Branches" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2-icon lucide-building-2"><path d="M10 12h4" /><path d="M10 8h4" /><path d="M14 21v-3a2 2 0 0 0-4 0v3" /><path d="M6 10H4a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-2" /><path d="M6 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16" /></svg>
                            <span> Branches</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "UserManagement" ? "sidebar-selected" : "")">
                        <a asp-controller="UserManagement" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users-round-icon lucide-users-round"><path d="M18 21a8 8 0 0 0-16 0" /><circle cx="10" cy="8" r="5" /><path d="M22 20c0-3.37-2-6.5-4-8a5 5 0 0 0-.45-8.3" /></svg>
                            <span> User Management</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "ProductRequest" ? "sidebar-selected" : "")">
                        <a asp-controller="ProductRequest" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-list-icon lucide-clipboard-list"><rect width="8" height="4" x="8" y="2" rx="1" ry="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" /><path d="M12 11h4" /><path d="M12 16h4" /><path d="M8 11h.01" /><path d="M8 16h.01" /></svg>
                            <span> Product Request</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Deliveries" ? "sidebar-selected" : "")">
                        <a asp-controller="Deliveries" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-map-pin-icon lucide-map-pin"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0" /><circle cx="12" cy="10" r="3" /></svg>
                            <span> Deliveries</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Orders" ? "sidebar-selected" : "")">
                        <a asp-controller="Orders" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shopping-cart-icon lucide-shopping-cart"><circle cx="8" cy="21" r="1" /><circle cx="19" cy="21" r="1" /><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12" /></svg>
                            <span> Orders</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "ActivityLog" ? "sidebar-selected" : "")">
                        <a asp-controller="ActivityLog" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity-icon lucide-activity"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2" /></svg>
                            <span> Activity Log</span>
                        </a>
                    </li>
                    <li class="sidebar-options @(currentController == "Report" ? "sidebar-selected" : "")">
                        <a asp-controller="Report" asp-action="Index">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-file-text-icon lucide-file-text"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z" /><path d="M14 2v5a1 1 0 0 0 1 1h5" /><path d="M10 9H8" /><path d="M16 13H8" /><path d="M16 17H8" /></svg>
                            <span>Report</span>
                        </a>
                    </li>
                </ul>
            </section>

            <section class="mt-auto border-t border-gray-800 p-4">

                <div class="py-2.5 px-3">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    Logout
                </div>

            </section>
        </aside>

        <div class="flex flex-col w-full">

            <header class="h-16 w-full bg-white flex justify-between items-center px-6 border-b border-gray-200 text-sm ">

                <div class="flex justify-between w-full ">
                    <div class="p-3 font-inter">
                        <div class="font-semibold color-gray-400">Welcome back, Juan</div>
                        <div class="font-light text-sm">Administrator</div>
                    </div>

                    <div class="flex items-center p-3 gap-4">
                        <i class="fa-regular fa-bell fa-xl"></i>
                        <i class="fa-solid fa-gear fa-xl"></i>
                    </div>
                </div>
            </header>

            <main role="main" class="flex-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
