@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login Page";
}

<div class="login-page">
    <div class="login-card max-w-md w-full bg-white/90 rounded-xl shadow-lg p-8">

        <!-- Logo Container -->
        <div class="flex justify-center mb-3">
            <div class="flex items-center justify-center w-20 h-20 rounded-lg bg-blue-600">
                <svg xmlns="http://www.w3.org/2000/svg" width="58" height="58" viewBox="0 0 24 24"
                     fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                     class="lucide lucide-warehouse-icon">
                    <path d="M18 21V10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v11" />
                    <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 1.132-1.803l7.95-3.974a2 2 0 0 1 1.837 0l7.948 3.974A2 2 0 0 1 22 8z" />
                    <path d="M6 13h12" />
                    <path d="M6 17h12" />
                </svg>
            </div>
        </div>


        <!-- Title -->
        <h1 class="text-2xl font-bold text-white text-center mb-1">WMS</h1>
        <p class="text-sm text-white text-center mb-6">
            Warehouse Management System<br>
        </p>

        <!-- Sign In Form -->
        <form asp-controller="Account" asp-action="DoLogin" method="post" class="space-y-4">
            <div>
                <label for="username" class="block text-sm font-medium text-white">Username</label>
                <input id="username" name="username" type="text" placeholder="Enter username"
                       class="mt-1 p-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
            </div>

            <div class="relative">
                <label for="password" class="flex items-center text-sm font-medium text-white">Password</label>

                <!-- Password input with extra right padding -->
                <input id="password" name="password" type="password" placeholder="Enter password"
                       class="mt-1 p-2 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 pr-10">

                <!-- Eye toggle button aligned inside the input -->
                <button type="button" onclick="togglePassword()"
                        class="absolute inset-y-0 top-5 right-3 text-gray-500 hover:text-indigo-600">

                    <!-- Eye icons -->
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-icon lucide-eye pass-true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0" /><circle cx="12" cy="12" r="3" /></svg>
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye-closed-icon lucide-eye-closed pass-false hidden"><path d="m15 18-.722-3.25" /><path d="M2 8a10.645 10.645 0 0 0 20 0" /><path d="m20 15-1.726-2.05" /><path d="m4 15 1.726-2.05" /><path d="m9 18 .722-3.25" /></svg>
                    </div>
                </button>
            </div>

            <div class="flex items-center justify-between text-sm">
                <label class="flex items-center">
                    <input type="checkbox" class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
                    <span class="ml-2 text-white">Remember Me</span>
                </label>
                <a href="#" class="text-blue-600 hover:underline">Forgot Password?</a>
            </div>

            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 rounded-md font-semibold hover:bg-indigo-700 transition">
                Sign In
            </button>
        </form>

        <!-- Sign Up Link -->
        <p class="text-sm text-white text-center mt-6">
            Don’t have an account?
            <a href="/Signup" class="text-blue-600 font-semibold hover:underline">Sign Up</a>
        </p>

        <!-- Footer -->
        <p class="text-xs text-gray-400 text-center mt-6">
            &copy; 2026 Warehouse Management System
        </p>
    </div>
</div>
