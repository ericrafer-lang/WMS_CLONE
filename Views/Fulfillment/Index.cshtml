@model List<practice_for_wms.Models.Entities.MyTask>
@{
    ViewData["Title"] = "Fulfillment";
}

<div class="p-4 lg:p-6">
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">Order Fulfillment</p>
            <p>@Model.Count(t => t.Status != "Completed") active orders</p>
        </div>

        <div class="flex justify-center items-center gap-3">
            <button type="button" id="openModalBtn"
                    class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2 hovering">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                <span>New Order</span>
            </button>

            <div id="fulfillmentModal" class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                    <div class="modal-header">
                        <div class="modal-header-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                        </div>
                        <div class="modal-header-text">
                            <h2>New Fulfillment Order</h2>
                            <p>Create a new order and assign it to a staff member.</p>
                        </div>
                        <button type="button" id="closeModalBtn" class="modal-close-btn close-modal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    </div>

                    <form asp-action="Create" asp-controller="Fulfillment" method="post">
                        <div class="grid grid-cols-2 gap-4">

                            <div class="col-span-2">
                                <label class="font-medium">Title</label>
                                <input name="Title" required
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div>
                                <label class="font-medium">Assigned To</label>
                                <select name="AssignedToId" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                                    <option value="">Select staff member</option>
                                    @foreach (var user in (List<practice_for_wms.Models.Entities.User>)ViewBag.Users)
                                    {
                                        <option value="@user.Id">@user.FirstName @user.LastName</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="font-medium">Branch</label>
                                <select name="BranchId" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required>
                                    <option value="">Select branch</option>
                                    @foreach (var branch in (List<practice_for_wms.Models.Entities.Branch>)ViewBag.Branches)
                                    {
                                        <option value="@branch.Id">@branch.BranchName</option>
                                    }
                                </select>
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Priority</label>
                                <select name="Priority" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    <option>Low</option>
                                    <option selected>Medium</option>
                                    <option>High</option>
                                </select>
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Description</label>
                                <textarea name="Description"
                                          class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                            </div>
                        </div>

                        <div class="modal-footer">
                            <button type="button" id="cancelModal" class="close-modal btn-secondary hovering">Cancel</button>
                            <button type="submit" class="btn-primary hovering">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
                                Create Order
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Order#</th>
                        <th>Title</th>
                        <th>Assigned To</th>
                        <th>Priority</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var task in Model)
                        {
                            var priorityClass = task.Priority?.ToLower() switch {
                                "high" => "high",
                                "medium" => "medium",
                                "low" => "approve",
                                _ => "medium"
                            };

                            var statusClass = task.Status?.ToLower() switch {
                                "pending" => "pending",
                                "rejected" => "rejected",
                                "completed" => "done",
                                "done" => "done",
                                _ => "approve"
                            };

                            <tr>
                                <td class="table-product-name">@task.Id.ToString("D3")</td>
                                <td>@task.Title</td>
                                <td>@(task.AssignedTo != null ? $"{task.AssignedTo.FirstName} {task.AssignedTo.LastName}" : "Unassigned")</td>
                                <td>
                                    <span class="badge @priorityClass">
                                        @task.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @statusClass">
                                        @task.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-6 text-gray-500 font-medium">No active fulfillment orders.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('fulfillmentModal');
        const openBtn = document.getElementById('openModalBtn');
        const cancelBtn = document.getElementById('cancelModal');
        const closeBtn = document.getElementById('closeModalBtn');

        function showModal() {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        function hideModal() {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        openBtn.addEventListener('click', showModal);
        cancelBtn.addEventListener('click', hideModal);
        if (closeBtn) closeBtn.addEventListener('click', hideModal);
        modal.addEventListener('click', function (e) {
            if (e.target === modal) hideModal();
        });
    });
</script>
