@{
    ViewData["Title"] = "User Management";

    var userCount = Model.Users?.Count() ?? 0;}



@model practice_for_wms.Models.ViewModels.UserManagement.UserManagementIndexViewModel

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                User Management
            </p>

            <p>
                @userCount @(userCount == 1 || userCount == 0 ? "User" : "Users")
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">

            <button class="open-modal flex btn-style bg-blue-600 text-white text-sm gap-2 hovering" data-modal="userModal">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-plus-icon lucide-user-plus"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" x2="19" y1="8" y2="14" /><line x1="22" x2="16" y1="11" y2="11" /></svg>
                <span>Invite User</span>
            </button>

            <!-- Modal Overlay -->
            <div id="userModal"
                 class="modal-overlay fixed inset-0 bg-black/50 hidden justify-center items-center z-50">

                <!-- Modal -->
                <div class="modal bg-white rounded-xl shadow-xl w-full max-w-xl p-6 relative">
                    <div class="modal-header">
                        <div class="modal-header-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
                        </div>
                        <div class="modal-header-text">
                            <h2>Invite New User</h2>
                            <p>Fill in the details to invite a new team member.</p>
                        </div>
                        <button type="button" class="modal-close-btn close-modal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                        </button>
                    </div>

                    <form asp-controller="UserManagement" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="grid grid-cols-2 gap-4">

                            <div class="col-span-2">
                                <label class="font-medium">First Name: <span class="text-red-500">*</span></label>
                                <input asp-for="CreateUser.FirstName" type="text" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Middle Name: <span class="text-red-500">*</span></label>
                                <input asp-for="CreateUser.MiddleName" type="text" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Surname: <span class="text-red-500">*</span></label>
                                <input asp-for="CreateUser.LastName" class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" required />
                            </div>

                            <div class="col-span-2">
                                <label class="font-medium">Email Address: <span class="text-red-500">*</span></label>
                                <input asp-for="CreateUser.Email" type="email" placeholder="email@example.com"
                                       class="w-full rounded-lg border border-gray-300 p-2 shadow-sm focus:border-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none" required />
                            </div>

                            <div>
                                <div class="form-group">
                                    <label class="form-label">Role <span class="text-red-500">*</span></label>

                                    <select asp-for="CreateUser.Role" class="modern-select">
                                        <option>-Select Role-</option>
                                        <option value="admin">Administrator</option>
                                        <option value="supervisor">Supervisor</option>
                                        <option value="staff">Staff</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Branch</label>

                                    <select asp-for="CreateUser.BranchId" class="modern-select">
                                        <option value="">Select a branch</option>

                                        @foreach (var branch in Model.Branches)
                                        {
                                            <option value="@branch.Id">
                                                @branch.BranchName
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="close-modal btn-secondary hovering">
                                Cancel
                            </button>
                            <button type="submit" class="btn-primary hovering">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 2 11 13"/><path d="m22 2-7 20-4-9-9-4z"/></svg>
                                Send Invite
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Branch</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Last Login</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="table-product-name">@user.FirstName @user.MiddleName @user.LastName</td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge @( (user.Role ?? string.Empty).ToLowerInvariant() )">
                                        @user.Role
                                    </span>
                                </td>
                                <td>
                                    @user.Branch?.BranchName 
                                </td>
                                <td>
                                    <span class="badge @(user.Status.ToString().ToLowerInvariant())">
                                        @user.Status
                                    </span>
                                </td>
                                <td>@user.CreatedAt.ToString("MM/dd/yyyy")</td>
                                <td>
                                    @(user.LastLogin.HasValue
                                    ? user.LastLogin.Value.ToString("MM/dd/yyyy")
                                    : "Never logged in")
                                </td>
                                <td>
                                    <div class="flex justify-center items-center gap-3 h-full">
                                        <button class="hovering">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                                        </button>
                                        <form asp-controller="UserManagement" asp-action="Delete" asp-route-id="@user.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btndelete hovering">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                            </button>
                                        </form>
                                        
                                    </div>
                                </td>
                            </tr>   
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center p-4">No users found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>