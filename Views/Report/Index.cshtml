@{
    ViewData["Title"] = "Report";
}

<div class="p-4 lg:p-6">
    @* HEADING !!!!!!*@
    <div class="flex justify-between items-center">
        <div class="flex flex-col">
            <p class="font-bold text-2xl mb-1">
                Reports
            </p>

            <p class="">
                Generate, export, and print reports
            </p>
        </div>

        <div class="flex justify-center items-center gap-3">
            <select class="flex flex-column btn-style gap-3 shadow-md px-5">
                <option>
                    Inventory Report
                </option>
                <option>
                    Low Stock Report
                </option>
                <option>
                    Product Movement Report
                </option>
                <option>
                    Supplier Report
                </option>
                <option>
                    Delivery Report
                </option>
                <option>
                    Branches Report
                </option>
                <option>
                    Supplier Orders Report
                </option>
                <option>
                    Staff Activity Report
                </option>
            </select>

            <button class="flex btn-style shadow-md text-sm gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-download-icon lucide-download"><path d="M12 15V3" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="m7 10 5 5 5-5" /></svg>
                <span>Export CSV</span>
            </button>

            <button class="flex btn-style shadow-md text-sm gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-printer-icon lucide-printer"><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6" /><rect x="6" y="14" width="12" height="8" rx="1" /></svg>
                <span>Print / PDF</span>
            </button>
        </div>
    </div>

    @* GRAPH !!!!!!*@
    <div class="flex p-5 mt-5 grid-card">
        GRAPH
    </div>

    @* TABLE !!!!!!*@
    <div class="card flex flex-col justify-center items-start mt-5 rounded-xl w-full">
        @* HEADER !!!!!!*@
        <div class="flex items-center card w-[30%] m-3 p-2">
            <span class="mr-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-search-icon lucide-search">
                    <path d="m21 21-4.34-4.34" />
                    <circle cx="11" cy="11" r="8" />
                </svg>
            </span>
            <input placeholder="Search..." class="font-sm w-full" />
        </div>

        @* TABLE DATA!!!!!!*@
        <div class=" w-full">
            <table class="product-table w-full border-collapse">
                <thead class="">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Supplier</th>
                        <th>Category</th>
                        <th>Qty</th>
                        <th>Quality</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>TRD-001</td>
                        <td class="table-product-name">Circuit Board A1</td>
                        <td>SOLIS MENDEZ WAREHOUSE</td>
                        <td>Electronics</td>
                        <td>250 pcs</td>
                        <td>
                            <span class="badge good">
                                Good
                            </span>
                        </td>
                        <td>
                            <span class="badge active">
                                Active
                            </span>
                        </td>
                        <td class="flex gap-3">
                            <button class="badge inline-flex">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                            </button>
                            <button class="btndelete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>TRD-001</td>
                        <td class="table-product-name">Circuit Board A1</td>
                        <td>SOLIS MENDEZ WAREHOUSE</td>
                        <td>Electronics</td>
                        <td>250 pcs</td>
                        <td>
                            <span class="badge inspection">
                                Under Inspection
                            </span>
                        </td>
                        <td>
                            <span class="badge active">
                                Active
                            </span>
                        </td>
                        <td class="flex gap-3">
                            <button class="badge inline-flex">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                            </button>
                            <button class="btndelete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            </button>
                        </td>
                    </tr>
                    <tr>
                        <td>TRD-001</td>
                        <td class="table-product-name">Circuit Board A1</td>
                        <td>SOLIS MENDEZ WAREHOUSE</td>
                        <td>Electronics</td>
                        <td>250 pcs</td>
                        <td>
                            <span class="badge bad">
                                Bad
                            </span>
                        </td>
                        <td>
                            <span class="badge inactive">
                                Inactive
                            </span>
                        </td>
                        <td class="flex gap-3">
                            <button class="badge inline-flex">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-pen-icon lucide-square-pen"><path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z" /></svg>
                            </button>
                            <button class="btndelete">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6" /><path d="M14 11v6" /><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" /><path d="M3 6h18" /><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                            </button>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
