@{
    ViewData["Title"] = "DeliveryReceiving";
}

<div class="p-4 lg:p-6">
    <h1 class="text-2xl font-bold">
        Delivery Receiving
    </h1>

    <p class="text-sm mt-1 text-[#65758B]">
        Check incoming deliveries and report defective products
    </p>

    <p class="text-md font-semibold mt-8 text-[#65758B]">
        PENDING/INCOMING
    </p>

    @* Pending/Incoming card details *@
    <div class="h-30 bg-white border border-gray-200 rounded-2xl p-6 mt-6">
        <div class="flex justify-between items-center">
            <div>

                <div class="flex items-center gap-3">
                    <h3 class="text-l font-semibold">
                        Global Materials Co.
                    </h3>
                    <span class="bg-cyan-100 text-[#0E7490] font-semibold rounded-full px-3 py-1 text-xs">
                        Arrived
                    </span>

                </div>
                <p class="text-sm text-gray-500 mt-2">
                    Branch: East Distribution • Expected: —
                </p>
                <p class="text-sm text-gray-500">
                    1 items in shipment
                </p>
            </div>

            @*Receive/Inspect Button*@
            <button onclick="openModal('receiveModal')" class="flex item-center gap-2 text-sm bg-blue-600 text-white px-6 py-2 rounded-xl">

                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.5"
                     stroke="currentColor"
                     class="w-5 h-5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M21 8.25v7.5a2.25 2.25 0 0 1-1.133 1.957l-6.75 3.857a2.25 2.25 0 0 1-2.234 0l-6.75-3.857A2.25 2.25 0 0 1 3 15.75v-7.5m18 0-9 5.25m9-5.25-9-5.25m9 5.25-9 5.25m-9-5.25 9-5.25m-9 5.25 9 5.25" />
                </svg>
                Receive & Inspect
            </button>
        </div>
    </div>

    <div class="h-30 bg-white border border-gray-200 rounded-2xl p-6 mt-5">
        <div class="flex justify-between items-center">
            <div>

                <div class="flex items-center gap-3">
                    <h3 class="text-l font-semibold">
                        PackRight Solutions
                    </h3>
                    <span class="bg-[#FEF3C7] text-[#B45309] font-semibold rounded-full px-3 py-1 text-xs">
                        Inspecting
                    </span>

                </div>
                <p class="text-sm text-gray-500 mt-2">
                    Branch: East Distribution · Expected: —
                </p>
                <p class="text-sm text-gray-500">
                    1 items in shipment
                </p>
            </div>

            @*Details*@
            <button onclick="openModal('receiveModal')"
                class="flex item-center gap-2 text-sm bg-blue-600 text-white px-6 py-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.5"
                     stroke="currentColor"
                     class="w-5 h-5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M21 8.25v7.5a2.25 2.25 0 0 1-1.133 1.957l-6.75 3.857a2.25 2.25 0 0 1-2.234 0l-6.75-3.857A2.25 2.25 0 0 1 3 15.75v-7.5m18 0-9 5.25m9-5.25-9-5.25m9 5.25-9 5.25m-9-5.25 9-5.25m-9 5.25 9 5.25" />
                </svg>
                Receive & Inspect
            </button>
        </div>
    </div>

    <p class="text-md font-semibold mt-8 text-[#65758B]">
        RECEIVING
    </p>
    @*Details*@
    <div class="h-25 bg-white border border-gray-200 rounded-2xl p-6 mt-6">
        <div class="flex justify-between items-center">
            <div>

                <div class="flex items-center gap-3">
                    <h3 class="text-l font-semibold">
                        Global Materials Co.
                    </h3>
                    <div class="">
                        <span class="bg-[#D1FAE5] text-[#047857] font-semibold rounded-full px-3 py-1 text-xs">
                            Completed
                        </span>
                        <span class="bg-gray-100 text-gray-500 font-semibold rounded-full px-3 py-1 text-xs m-2">
                            Partial Defect
                        </span>
                    </div>
                </div>
                <p class="text-sm text-gray-500 mt-2">
                    Received: 2026-07-14 · By: Clarence Mendoza · 66 arrived, 12 defective
                </p>
            </div>

            @*View Report Button*@
            <button onclick="openModal('viewReportModal')"
                class="icon-button flex items-center gap-2 text-sm px-5 py-2 rounded-xl">
                <svg xmlns="http://www.w3.org/2000/svg"
                     fill="none"
                     viewBox="0 0 24 24"
                     stroke-width="1.5"
                     stroke="currentColor"
                    
                     class="eye-icon w-5 h-5">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
            </button>
        </div>
    </div>
</div>
<partial name="_ReceivingInspectModal" />
<partial name="viewFormModal" />
<script>

    function openModal(modalId) {
        document.getElementById(modalId)
            .classList.remove("hidden");
    }

    function closeModal(modalId) {
        document.getElementById(modalId)
            .classList.add("hidden");
    }


</script>